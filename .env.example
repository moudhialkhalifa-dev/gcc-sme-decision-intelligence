# Copy to .env (never commit .env).
POSTGRES_PASSWORD=change-me-long-random
# If set, every /api call except /api/health needs the header X-API-Key (the dashboard asks for it once).
API_KEY=change-me-or-leave-empty-for-open-demo
MAX_UPLOAD_MB=150
HTTP_PORT=80
# Only needed when the dashboard is served from a different origin than the API.
CORS_ORIGINS=
LOG_LEVEL=INFO
